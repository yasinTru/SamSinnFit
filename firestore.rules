rules_version = '2';

// SamSinn Fitness Firestore güvenlik kuralları.
// Sadece aşağıdaki listedeki Google hesapları verileri okuyup yazabilir.
// Kendi e-posta adreslerinizi (küçük harfle) yazın, sonra bu dosyanın tamamını
// Firebase Console > Firestore Database > Kurallar (Rules) sekmesine yapıştırıp "Yayınla"ya basın.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'kisi1@gmail.com',
          'kisi2@gmail.com'
        ];
    }

    function isValidEntry(data) {
      return data.keys().hasOnly(['userId', 'date', 'type', 'name', 'calories', 'meal',
                                  'duration', 'notes', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() <= 40
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (
          (data.type == 'food'
            && data.calories is int && data.calories >= 0 && data.calories <= 20000
            && data.meal in ['sabah', 'ogle', 'aksam', 'ara'])
          ||
          (data.type == 'exercise'
            && data.duration is string && data.duration.size() > 0 && data.duration.size() <= 100
            && data.get('notes', '') is string && data.get('notes', '').size() <= 300)
        );
    }

    // Beslenme ve spor kayıtları (her kayıt ayrı bir belge)
    match /entries/{entryId} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && isValidEntry(request.resource.data);
    }

    // Kişi isimleri
    match /settings/people {
      allow read: if isMember();
      allow write: if isMember()
        && request.resource.data.keys().hasOnly(['users'])
        && request.resource.data.users is list
        && request.resource.data.users.size() > 0
        && request.resource.data.users.size() <= 10;
    }
  }
}
